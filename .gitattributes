# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts and git hooks must keep LF endings to run under bash
*.sh text eol=lf
scripts/git-hooks/* text eol=lf
.beads/hooks/* text eol=lf

# CAD and other binary formats: never normalize, never diff as text
*.sldprt binary
*.SLDPRT binary
*.sldasm binary
*.SLDASM binary
*.slddrw binary
*.SLDDRW binary
*.x_b binary
*.3mf binary
*.stl binary
*.STL binary
*.png binary
*.bmp binary

# Text CAD formats: keep exact bytes, they are compared in tests
*.x_t -text
*.step -text

# Fixture kit records: keep exact bytes so SHA256SUMS.txt verifies on every platform
tests/fixtures/generation.log -text
tests/fixtures/ground_truth.json -text
tests/fixtures/scrub_report.txt -text
tests/fixtures/SHA256SUMS.txt -text
tests/generated/* -text

# Licence texts: keep the exact bytes their publishers give, checked by tests/test_third_party_notices.py
licenses/* -text

# three.js as its publisher ships it, for the service's reference viewer: keep the exact bytes,
# whose hashes tests/test_serve_viewer.py checks on every platform
src/solidseas/serve/viewer/three/** -text
