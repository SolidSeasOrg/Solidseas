# Contents/Config-0-ResolvedFeatures: the feature tree (section 15.5). It continues the
# archive of Contents/Config-0 (15.0.4). Proved on o01, o02, o03, o07 and o12, and on o11
# (a box, a fillet, a hole and a fillet); the circle sketch and the cut also on o10 record by
# record (15.5.12, 15.5.13, 15.5.14).
@member Contents/Config-0-ResolvedFeatures
@include config-0-macros.srl
@section 15.5.1
@archive continue
@archive set header
u32 $_archive.header      # the archive's next index after Contents/Config-0
u16 =17+len($features)    # top-level features: the template's 17, then the design's
@include config-0-resolvedfeatures-fixed.srl
@section 15.5.6
@for f in $features
@if $f.sketch
@if $f.circle
@include config-0-resolvedfeatures-circle.srl
@else
@include config-0-resolvedfeatures-sketch.srl
@endif
@else
@if $f.fillet
@include config-0-resolvedfeatures-fillet.srl
@else
@if $f.cut
@include config-0-resolvedfeatures-cut.srl
@else
@include config-0-resolvedfeatures-extrude.srl
@endif
@endif
@endif
@endfor
@section 15.5.1
u32 0   # the end of the feature list
