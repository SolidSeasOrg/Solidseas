# Contents/Config-0-ResolvedFeatures, section 15.5.7: one corner rectangle sketch on
# the Front Plane, the features item $f. Its four corners, in the sketch's frame (the
# Front Plane: x along model X, y along model Y), are P1 = (x0, y0), P2 = (x1, y1),
# P3 = (x0, y1), P4 = (x1, y0) with $f.corners = [x0, y0, x1, y1]. When P1 is on the
# origin ($f.at_origin) the sketch carries the records that tie it to the origin point.
@section 15.5.7
class moProfileFeature_c 1 as $f.name
@use nodehead NAME=$f.name FLAGS=0x40000000 UID=$f.id
u16 0  # children
@use feattail ID==$fixed.id_base+11+$f_index STAMP=1 MEMO=$f.cache_memo TIME=$f.time
u32 1
rep 14 00
class sgSketch 1
u32 =4+int($f.at_origin)   # sketch records
rep 6 00
@use point ID=1 TIED=int($f.at_origin) X=$f.corners.0 Y=$f.corners.1
# The lines: a handle names a line by its number; the first handle of a line that
# reaches a corner not written yet carries that corner's point record.
@use linehandle LINE=1
@use linepoint LINE=2 ID=2 X=$f.corners.2 Y=$f.corners.3
@use linehandle LINE=3
@use linepoint LINE=4 ID=3 X=$f.corners.0 Y=$f.corners.3
@use linehandle LINE=2
@use linepoint LINE=3 ID=4 X=$f.corners.2 Y=$f.corners.1
@use linehandle LINE=1

@if $f.at_origin
# The fourth line, then the coincidence of P1 with the origin's point (Point1@Origin):
# an external entity, its reference, the origin point's backed-up record.
class sgLineHandle 1
u16 4
i32 -1
u32 0
u16 0
i32 -2
rep 36 00
u32 1
rep 2 00
u32 5
u32 0x1FFFFF
u8 3
i32 -1 -1
f32 -1
u32 1
u16 0 4 2
u32 1
f32 -1
