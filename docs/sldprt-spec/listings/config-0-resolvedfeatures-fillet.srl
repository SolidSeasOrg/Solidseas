# The fillet's tangent points in the dimension's frame: (r, 0, 0) and (0, -r, 0) for the box's
# edges; for the hole's edge, which has none, the frame's own point twice.
@if $f.hole
f64 =-$f.anchor.0 $f.anchor.2 =-$f.anchor.1
f64 =-$f.anchor.0 $f.anchor.2 =-$f.anchor.1
@else
f64 $f.radius 0.0 0.0
f64 0.0 =-$f.radius 0.0
@endif
rep 6 00
