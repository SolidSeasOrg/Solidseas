class moCThreadRefMgr_c 1
# moCThreadRefMgr_c: the mass properties of the bodies, a cache SOLIDWORKS keeps once
# they have been evaluated (15.4.11). The generator writes the empty form.
rep 23 00
@if $config0.mass_block
u32 1 1 =len($bodies)
@for b in $bodies
u32 $b.id =$doc.stamp2-2*(len($bodies)-1-$b_index)   # body id, mass tag (15.4.9)
f64 1.0
@endfor
f64 $config0.mass.0 $config0.mass.1 $config0.mass.2      # centre of mass
f64 $config0.mass.3 $config0.mass.4 $config0.mass.5      # volume, area, mass
f64 $config0.mass.6 $config0.mass.7 $config0.mass.8      # moments of inertia
f64 $config0.mass.9 $config0.mass.10 $config0.mass.11    # products of inertia
u32 1
rep 16 00
f64 0.995
rep 16 00
cstr ""
cstr ""
rep 28 00
f64 1.0
rep 24 00
f64 1.0
rep 24 00
f64 1.0
u32 1
rep 6 00
@else
u32 0 0 0
@endif
