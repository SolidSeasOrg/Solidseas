cstr "ANSI31 (Iron BrickStone)"
u32 0 0
f64 1.0
u32 0 0 1
i32 -1 -1
u32 0
class moMaterial_c 1
# moDensityParameter_c: the material's density, a parameter like 15.5.8's D1.
class moDensityParameter_c 1
u16 0
u32 0 0x40000000
i32 -1
u32 0
cstr ""
u16 0
f64 1000.0   # density, kg/m3: no material (2700 with 1060 Alloy in o05)
u8 0

@section 15.4.6
# uoModelData_c: the bodies of the part, one moAtom_c each, newest first.
class uoModelData_c 1
rep 34 00
@endsized
@sized u32 tail_size   # the tail: bytes from the next field to the end of the member (15.4.1)
rep 6 00
u32 =100+len($bodies) =len($bodies)   # the newest body's id, the number of bodies
@for b in $bodies reversed
class moAtom_c 1 as $b.label
u16 0
u32 1 0x40000000
i32 -1
u32 0
cstr ""
rep 12 00
u32 $b.id 0                # body id: 101 for the first body, then 102 ...
u32 $b.feature $b.feature        # creation number of the feature that made the body
rep 12 00
u32 1
i32 -1
u32 $b.regen 1 $b.regen 6  # free (15.4.10)
@endfor
@if $model.solid
u32 17000 10001
hex 01
rep 2 00
u32 2560288 5120
rep 5 00
i32 -1
u32 1
i32 -1
u32 0 0
@else
u32 17000 10000
hex 00 00 00 10
@endif

