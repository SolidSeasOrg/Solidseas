@section 15.4.5
# moUnitComponent_c's curvature object: present once the part has a body.
@if $model.solid
class gcCurvatureObject_c 1
f64 1000.0
hex 9A 99 99 99 99
u32 4210585
rep 3 00
f32 2.25
f64 1.2 1.0
u64 $config0.curvature_time
@else
u16 0   # no object
@endif

# moTransRefPlaneData_c: the stored box of the model and its bounding sphere.
class moTransRefPlaneData_c 1
u32 1 1 16221267 6759173 95 0
@if $model.solid
u8 1
f64 $model.sphere.0 $model.sphere.1 $model.sphere.2   # bounding sphere: centre
f64 $model.max.0 $model.max.1 $model.max.2
f64 $model.min.0 $model.min.1 $model.min.2
f64 $model.sphere.3                                   # bounding sphere: radius
@else
u8 0
@endif
rep 22 00
f64 2.0
hex 8F 40
f64 1e-08
u32 2
rep 2 00
hex AA AA AA AA BB
u32 12303291
rep 3 00
u32 =int($model.solid)
rep 78 00
u32 =101+len($features)   # 101 and one for each feature (15.4.5)
rep 2 00
