# Contents/Config-0: the document's settings archive (section 15.4).
# One MFC CArchive with Contents/Config-0-ResolvedFeatures (15.0.4). Proved on o01, o02,
# o03, o07 and o12 (15.4.12).
@member Contents/Config-0
@include config-0-macros.srl
@section 15.4.1
@archive start 2
class moPart_c 1
@sized u32 settings_size   # the settings run: bytes from the next field to the size field of uoModelData_c (15.4.1)
u32 0 17000
# The document node: the part's internal name (15.6.1).
class moNodeName_c 1
cstr $doc.name
u32 0 0x40000000 0 =256+32*int($model.solid)   # flags: 0x20 once the part has a body
cstr ""
u32 0

@section 15.4.3
# moVisualProperties_c: the part's appearance, the same object as in Contents/CMgr
# (15.2.9), with the same appearance file.
@include visual-properties.srl
@use visualprops TEXTURE=$cmgr.texture N=3

