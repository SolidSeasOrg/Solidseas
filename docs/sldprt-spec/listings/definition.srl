# Contents/Definition: the document type, the view at save, the drafting standard's line
# styles and fonts, the user model environment and the design journal (section 15.2.11).
# Proved on o01, o02, o03, o07 and o12.
@member Contents/Definition
@section 15.2.11.1
u32 7 0 50 1 1                     # not decoded, constant
# The document type: {83A33D30-27C5-11CE-BFD4-00400513BB57}, a part (docs/FORMAT.md 6)
u32 0x83A33D30
u16 0x27C5 0x11CE
u8 0xBF 0xD4 0x00 0x40 0x05 0x13 0xBB 0x57
rep 3 00
u8 1

@section 15.2.11.2
# The view at save (15.2.11.2), a free value: a rotation, a translation, a scale, then the
# view's centre and zoom
@define view
f64 $def.view.r.0 $def.view.r.1 $def.view.r.2    # the rotation, by rows
f64 $def.view.r.3 $def.view.r.4 $def.view.r.5
f64 $def.view.r.6 $def.view.r.7 $def.view.r.8
f64 0.0 0.0 0.0                    # the translation
f64 1.0                            # the scale
u16 0
f64 $def.view.c.0 $def.view.c.1 $def.view.c.2    # the centre of the window, model space
f64 $def.view.zoom                 # the zoom
u8 0
u16 3 1                            # not decoded, constant
@end
@use view
hex 02 FA 8C A6 3F 09 14 00 78     # not decoded, constant

