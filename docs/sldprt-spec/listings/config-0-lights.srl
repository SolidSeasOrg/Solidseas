# Contents/Config-0, section 15.4.8: the Lights and Cameras folder (moEnvFolder_c) and
# its four lights: Ambient and three directional lights, as the template has them.
class moEnvFolder_c 1 as env_folder
@use nodehead NAME="Lights and Cameras" FLAGS=0x40000000 UID=6
u16 4  # children
class moAmbientLight_c 1
@use nodehead NAME="Ambient" FLAGS=0xc0000000 UID=12
u16 0  # children
@use feattail ID=101 STAMP=0 MEMO=0.0 TIME=0x1da7f0beaae8d3c
u32 1 0
f64 0.3
rep 16 00
u32 16777215 0 1 0 1
cstr "Ambient-1"
rep 12 00
f64 1.0
u32 1 0
f32 2.75
u32 0
class moDirectionLight_c 1
@use nodehead NAME="Directional1" FLAGS=0xc0000000 UID=13
u16 0  # children
@use feattail ID=101 STAMP=0 MEMO=0.0 TIME=0x1da7f0beaae8d3c
u32 1 0
f64 0.1 0.3 0.3
u32 16777215 0 1 0 1
cstr "Directional-1"
rep 12 00
f64 1.0
u32 1 0
f32 2.75
u32 0
f64 7.1 7.1
rep 16 00
class moDirectionLight_c 1
@use nodehead NAME="Directional2" FLAGS=0xc0000000 UID=14
u16 0  # children
@use feattail ID=101 STAMP=0 MEMO=0.0 TIME=0x1da7f0beaae8d3c
u32 1
rep 12 00
f64 0.1 0.3
u32 16777215 0 1 0 1
cstr "Directional-1"
rep 12 00
f64 1.0
u32 1 0
f32 2.75
u32 0
f64 -3.4 6.1 -7.1
u32 0 0
class moDirectionLight_c 1
@use nodehead NAME="Directional3" FLAGS=0xc0000000 UID=15
u16 0  # children
@use feattail ID=101 STAMP=0 MEMO=0.0 TIME=0x1da7f0beaae8d3c
u32 1
rep 12 00
f64 0.2 0.3
u32 16777215 0 1 0 1
cstr "Directional-1"
rep 12 00
f64 1.0
u32 1 0
f32 2.75
u32 0
f64 -9.2 3.4 -1.8
u32 0 0
# The folder's own tail: stamped and numbered once the part has a feature (15.5.4).
@if $model.solid
@use feattail ID==$fixed.id_base+8 STAMP=1 MEMO=0.0 TIME=$fixed.lights.time
@else
@use feattail ID=101 STAMP=0 MEMO=0.0 TIME=$fixed.lights.time
@endif
u32 1 1
rep 6 00
