@section 15.3.6
# Cell at 0x056f: the table of contents, 288 bytes of MessagePack
@use cell HASH=0x0B8822AB KEYLEN=3 DATALEN=288 NEXT=0x03A2
latin1 "TOC"                     # the key; 0x0B8822AB is its hash
u8 0x82                          # a map of 2 pairs
u8 0xa5                          # key, fixstr of 5
utf8 "class"
u8 0xaa                          # fixstr of 10
utf8 "object-map"
u8 0xa5                          # key, fixstr of 5
utf8 "model"
u8 0x84                          # a map of 4 pairs
u8 0xa5                          # key, fixstr of 5
utf8 "class"
u8 0xa8                          # fixstr of 8
utf8 "moPart_c"
u8 0xa8                          # key, fixstr of 8
utf8 "configid"
u8 0                             # positive fixint
u8 0xaa                          # key, fixstr of 10
utf8 "configname"
u8 0xa7                          # fixstr of 7
utf8 "Default"
u8 0xa6                          # key, fixstr of 6
utf8 "object"
u8 0x84                          # a map of 4 pairs
u8 0xa5                          # key, fixstr of 5
utf8 "class"
u8 0xac                          # fixstr of 12
utf8 "moRefPlane_c"
# one entry per reference plane, in the order of $exch.toc (15.3.6)
@for g in $exch.toc
u8 0xa6                          # key, fixstr of 6
utf8 "object"
u8 0x82                          # a map of 2 pairs
u8 0xa5                          # key, fixstr of 5
utf8 "class"
u8 0xa6                          # fixstr of 6
utf8 "object"
u8 0xa4                          # key, fixstr of 4
utf8 "guid"
u8 0xd9                          # str 8
u8 36
utf8 $g                          # a plane record's GUID
@endfor

@section 15.3.7
# Cell at 0x06ac: the document record, 122 bytes of MessagePack
@use cell HASH=$exch.hash.doc KEYLEN=36 DATALEN=122 NEXT=0x056F
utf8 $exch.doc                   # the key: the document record's GUID as text
u8 0x85                          # a map of 5 pairs
u8 0xaf                          # key, fixstr of 15
utf8 "SaveAsNewCalled"
u8 0xc2                          # false
u8 0xa5                          # key, fixstr of 5
utf8 "class"
u8 0xab                          # fixstr of 11
utf8 "uiPartDoc_c"
u8 0xac                          # key, fixstr of 12
utf8 "platformflag"
u8 2                             # positive fixint
u8 0xbc                          # key, fixstr of 28
utf8 "repairDTForDefaultConfigflag"
u8 0xc2                          # false
u8 0xd9                          # key, str 8 of 39
u8 39
utf8 "useEnglishDescriptionForWeldmentCutList"
u8 0xc2                          # false

@section 15.3.4
# The free block: the rest of the page
u16be 0                          # next free block: none
u16be 0x089C                     # this block's size, to the end of the page
rep 2200 00
