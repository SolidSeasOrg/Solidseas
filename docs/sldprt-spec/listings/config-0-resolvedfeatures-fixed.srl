class moRefPlane_c 1
@use nodehead NAME="Front Plane" FLAGS=0xc0000000 UID=2
u16 0  # children
@use feattail ID=101 STAMP=0 MEMO=0.0 TIME=$fixed.front.time
# The plane's display: a rectangle around the model (15.5.5): label corner, rectangle, centre.
u32 1
rep 38 00
u32 1
rep 16 00
u32 1
rep 54 00
f64 =$model.centre.0-$planes.front.hu =$model.centre.1+$planes.front.hv 0.0   # label corner
u32 5
rep 10 00
class moDefaultRefPlnData_c 1
rep 40 00
f64 1.0
rep 25 00
f64 1.0
u8 0
f64 $planes.front.hu =-$planes.front.hu $planes.front.hv =-$planes.front.hv   # rectangle
rep 6 00
i32 -4 -4
u8 0
f64 $model.centre.0 $model.centre.1 0.0   # centre
u32 1
rep 12 00
