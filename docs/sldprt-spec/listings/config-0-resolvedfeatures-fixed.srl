# Contents/Config-0-ResolvedFeatures, section 15.5.3: the template's top-level
# features, Comments to Origin, with the history folder's entry for each feature of the
# design (15.5.3); the numbering of 15.5.4.
@section 15.5.3
class moCommentsFolder_c 1
@use nodehead NAME="Comments" FLAGS=0x40000000 UID=8
u16 0  # children
@use touchedtail K=0 TIME=$fixed.comments.time
u32 1 0 0
class moFavoriteFolder_c 1
@use nodehead NAME="Favorites" FLAGS=0x40000000 UID=23
u16 0  # children
@use touchedtail K=1 TIME=$fixed.favorites.time
u32 1 1 0 0 1
class moHistoryFolder_c 1
@use nodehead NAME="Folder " FLAGS=0x40000000 UID=24
u16 0  # children
@use touchedtail K=2 TIME=$fixed.history.time
u32 1 1 0
u16 =len($features)   # history entries
@for f in $features
# One history entry per feature: its creation number and time.
class moHistoryFeatItemData_c 1
u16 0
u32 1 0x40000000
i32 -1
u32 0
cstr ""
class moCompFeature_c 1
class moUnitComponent_c 1
u16 2
rep 41 00
i32 -1 -1 -1 -1
rep 20 00
u32 17000 $f.id $f.created   # version, the feature's creation number, Unix time
@endfor
