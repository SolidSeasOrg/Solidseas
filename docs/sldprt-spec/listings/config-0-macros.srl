# Definitions shared by Contents/Config-0 (15.4) and its feature stream (15.5).
# Every feature, folder, light and manager of the archive starts with the same
# feature record: a head (flags, creation number, child list) and a tail (feature id,
# version stamps, time). Section 15.4.2 gives each field.
@section 15.4.2

# The head of a feature record: reserved, flags, the feature's creation number,
# reserved, an empty comment, six reserved bytes. The child list follows it: a u16
# count, then each child (an object, or an objref when the child was written before).
@define feathead FLAGS UID
u32 0 %FLAGS %UID 0
cstr ""
rep 6 00
@end

# A named feature record: the name node (class moNodeName_c and the name), then the head.
@define nodehead NAME FLAGS UID
class moNodeName_c 1
cstr %NAME
@use feathead FLAGS=%FLAGS UID=%UID
@end

# The tail of a feature record, 111 bytes. ID is the feature id, STAMP is 1 when the
# record carries the version it was made in (17000, build 2024016), MEMO is a length
# SOLIDWORKS sometimes leaves there (15.5.9), TIME is a FILETIME written high word first.
@define feattail ID STAMP MEMO TIME
rep 12 00
u32 %ID 0
u8 0
u32 =17000*%STAMP =2024016*%STAMP   # made in: version, build (0 0 when not stamped)
u32 17000                           # saved in: version
f64 %MEMO
u32 2024016                         # saved in: build
u16 0
cstr ""
u8 0
i16 -1
u16 0
u8 3
i32 -1 -1
f32 -1
rep 14 00
u32 1
rep 6 00
i32 -1
u32 =%TIME//4294967296 =%TIME%4294967296   # FILETIME, high word first
u16 2
u32 350108
@end

# The tail of a template record that SOLIDWORKS numbers and stamps once the part has a
# feature (15.5.4): K is the record's place in the numbering, TIME its time.
@define touchedtail K TIME
@if $model.solid
@use feattail ID==$fixed.id_base+%K STAMP=1 MEMO=0.0 TIME=%TIME
@else
@use feattail ID=101 STAMP=0 MEMO=0.0 TIME=%TIME
@endif
@end

# A sketch point record (15.5.7): its number, whether it is tied to the origin point
# (0 or 1, as an expression), and x and y in metres in the sketch's frame. A corner
# rectangle's point ends with u16 0 and 2; a circle's points end otherwise (15.5.12), so
# the record is written as its core and that end.
@section 15.5.7
@define pointcore ID TIED X Y
u32 %ID 0x1FFFFF
u8 3
i32 -1 -1
f32 -1
u32 =%TIED
u16 0 =5-%TIED =1+%TIED
u32 1
f32 -1
u16 0
u32 4
rep 7 00
f64 1.0 0.0
u16 30
f64 %X %Y
@end

@define point ID TIED X Y
@use pointcore ID=%ID TIED=%TIED X=%X Y=%Y
u16 0 2
@end

# A handle of sketch line LINE that carries no point.
@define linehandle LINE
class sgLineHandle 1
u16 %LINE
i32 -1
u32 0
@end

# A handle of sketch line LINE that carries point ID at (X, Y).
@define linepoint LINE ID X Y
class sgLineHandle 1
u16 %LINE
i32 -1
u32 0
u16 0
i32 -2
rep 42 00
@use point ID=%ID TIED=0 X=%X Y=%Y
@end

# A face reference list's head (15.5.8, 15.5.13): KIND is the face's surface, 6 a plane and
# 5 a cylinder; FLAGS is 768 or 0; COUNTER is a free counter (15.5.9). Two doubles 1e100
# (an unset value) and u16 0 follow, then the list.
@section 15.5.13
@define faceref KIND FLAGS COUNTER
class moFaceRef_c 1
u32 1 0 %KIND %FLAGS %COUNTER
f64bits 0x54B249AD2594C37D 0x54B249AD2594C37D
rep 2 00
@end

# One face of the body, item E of a cut's ring (15.5.13), by its `kind` (15.5.13): 2 an end
# face of the box (a cap; face 0 on the sketch plane, 1 at the far end), 1 a side (the face
# of sketch line `face`), 4 a face of a fillet (the face it makes along its edge `face`), of
# the feature whose creation number is `uid`, made at `created`. L labels the entry.
@define cutface E L
@if =$%E.kind==2
class moEndFaceSurfIdRep_c 1 as %L
rep 2 00
class moFR_c 1
objref ext_obj
u32 $%E.uid $%E.created $%E.face
u32 0
@else
@if =$%E.kind==4
class moFilletSurfIdRep_c 1 as %L
@else
class moFromSktEntSurfIdRep_c 1 as %L
@endif
rep 2 00
class moFR_c 1
objref ext_obj
u32 $%E.uid $%E.created $%E.face
@endif
@end

# One entry of a list of faces (15.5.13, 15.5.14), item E, by its `kind`: 0 the end of one
# boundary loop of the face the list is about (u16 0 alone), 1 a side of an extrusion, 2 an
# end face of an extrusion, 3 the face a cut's circle swept, 4 a face of a fillet.
@section 15.5.14
@define faceentry E
@if =$%E.kind==0
rep 2 00
@else
@if =$%E.kind==1
class moFromSktEntSurfIdRep_c 1
@endif
@if =$%E.kind==2
class moEndFaceSurfIdRep_c 1
@endif
@if =$%E.kind==3
class moFromSktEnt3IntSurfIdRep_c 1
@endif
@if =$%E.kind==4
class moFilletSurfIdRep_c 1
@endif
rep 2 00
class moFR_c 1
objref ext_obj
u32 $%E.uid $%E.created $%E.face
@if =$%E.kind==2
u32 0
@endif
@if =$%E.kind==3
i32 -1
u32 0
@endif
@endif
@end

# The head of an edge reference (15.5.14), after its class: u32 1, 0, 4 (its four faces),
# 512, COUNTER (free, or 0), two doubles 1e100 (an unset value) and u16 0. Its four faces
# follow.
@define edgehead COUNTER
u32 1 0 4 512 %COUNTER
f64bits 0x54B249AD2594C37D 0x54B249AD2594C37D
rep 2 00
@end

# A component of the body whose id is BODY (15.5.14), as a cut names the body it cuts
# (15.5.13): the id twice.
@define bodycomponent BODY
class moUnitComponent_c 1
u16 2
rep 5 00
u32 %BODY %BODY
rep 28 00
i32 -1 -1 -1 -1
rep 20 00
u32 17000
@end

# A driving dimension's display object of class CLASS and its handle (15.5.8, 15.5.14): the
# extrusion's depth (moDisplayDistanceDim_c, KIND 18) and a fillet's radius
# (moDisplayRadialDim_c, KIND 20). VIEW is the number of the annotation view the dimension
# is drawn in (15.4.9). The other fields are not decoded.
@section 15.5.8
@define dimdisplay CLASS VIEW KIND
class %CLASS 1
rep 16 00
u32 65535
i32 -253
u32 255
u8 0
f32 -1
rep 14 00
u32 17000 0 524416
rep 83 00
f64 1.0
u8 0
u32 1 %VIEW
rep 19 00
f64 -1.0
u32 0 1
rep 2 00
f32 -1
u32 0 1
rep 2 00
f32 -1
rep 12 00
i32 -1 -1
u32 0 1
rep 6 00
f32 -1
rep 16 00
u32 4
rep 96 00
u32 2 0 0
f64 1.0
rep 16 00
f64 1.0
u32 0 0
cstr ""
rep 24 00
u32 %KIND
rep 30 00
f64 1.0
rep 16 00
f64 1e-06 1e-06
rep 18 00
f64 1.0
u32 0 1
class moFeatureDimHandle_c 1
rep 42 00
i32 -1 -1 -1 -1
rep 20 00
u32 17000
rep 15 00
i32 -1
rep 6 00
@end

# An annotation view of Contents/Config-0 (15.4.9): its name, its orientation as a rotation by
# rows (nine doubles given by their bits, so that -0.0 is exact), and its number.
@section 15.4.9
@define annotationview NAME NUMBER R11 R12 R13 R21 R22 R23 R31 R32 R33
class moAnnotationView_c 1
cstr %NAME
u8 1
f64bits %R11 %R12 %R13 %R21 %R22 %R23 %R31 %R32 %R33
rep 24 00
f64 1.0
rep 26 00
f64 1.0
rep 3 00
i32 -1
f64 -1.0
u32 0 %NUMBER
rep 58 00
u32 1
i32 -65536
u32 65535
i32 -65536 -1
hex FF FF
@end
